{
  "name": "Timer",
  "version": "1.3.0",
  "manifest_version": 3,

  "description": "This simple timer tells you when your time is up or starts a stopwatch.",
  "icons": {
    "16": "img/16.png",
    "32": "img/32.png",
    "48": "img/48.png",
    "128": "img/128.png"
  },

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_icon": "img/clock.png",
    "default_popup": "popup.html"
  },

  "offline_enabled": true,

  "permissions": [
    "notifications",
    "alarms",
    "storage"
  ],

  "web_accessible_resources": [
    {
      "resources": [
        "img/48.png",
        "offscreen.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
